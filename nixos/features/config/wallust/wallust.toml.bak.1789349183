# wallust v4, unified theming engine.
# Sources (all feed the same templates + hooks):
#   wallust cs <path-to-colorscheme.json>   curated (exact colors). Use the full
#       path to avoid clashing with built-in theme names.
#   wallust run <image>                      dynamic palette from a wallpaper
#   wallust theme <name>                     built-in theme

backend = "fastresize"
palette = "salience-dark"

[templates]
# Quickshell shell: writes colors.json; Theme.qml reads it live (no reload hook).
quickshell = { template = 'quickshell-colors.json', target = '~/.config/quickshell/colors.json' }
kitty      = { template = 'kitty.conf',  target = '~/.config/kitty/colors/wallust.conf' }
hyprland   = { template = 'hyprland.lua', target = '~/.config/hypr/colors/custom/wallust.lua' }
foot       = { template = 'foot.ini',    target = '~/.config/foot/colors/custom/wallust' }
# discord via Vesktop QuickCSS (settings/quickCss.css): Vesktop fs.watch's that
# file and re-injects live, so theme switches apply to Discord instantly.
discord    = { template = 'discord.css', target = '~/.config/vesktop/settings/quickCss.css' }
tmux       = { template = 'tmux.conf',  target = '~/.config/tmux/generated.conf' }
zen_chrome_hz3ab4gh   = { template = 'zen-userChrome.css',  target = '~/.zen/hz3ab4gh.Default Profile/chrome/userChrome.css' }
zen_content_hz3ab4gh  = { template = 'zen-userContent.css',  target = '~/.zen/hz3ab4gh.Default Profile/chrome/userContent.css' }
zen_chrome_4hnn7g3c   = { template = 'zen-userChrome.css',  target = '~/.zen/4hnn7g3c.Default Profile/chrome/userChrome.css' }
zen_content_4hnn7g3c  = { template = 'zen-userContent.css',  target = '~/.zen/4hnn7g3c.Default Profile/chrome/userContent.css' }
# GTK is NOT templated by wallust (option B): the custom GTK 3/4 themes are kept
# and switched by theme-apply.sh (symlink the per-theme gtk-4.0 + gsettings name).

[hooks]
# NOTE: wallust runs [hooks] only on `wallust run` (image), NOT on `cs`/`theme`.
# Curated switches go through theme-apply.sh which reloads apps itself.
# Quickshell needs no hook, Theme.qml's FileView reloads on change.
# foot needs none, new terminals pick up colors.
kitty    = "pkill -USR1 kitty || true"
hyprland = "hyprctl reload || true"

[templated_hooks]
notify = "notify-send 'Theme' 'Palette applied' -t 1500"

# --- GTK colors (wallust owns GTK now: each custom scheme => per-scheme theme dir).
# Slot-12 accent == exactly what Zen renders; slot-7 fg. Replaces the old hand-written GTK + option B.
"gtk4_anime
ariadne
catppuccin
e-ink
everblush
everforest
gruvbox
gruvbox-material
horizon
industrial
kanagawa
material-you
nightfox
noir
nord
rose-pine
rxyhn
tokyo-night
vira-palenight" = { template = 'gtk-colors.css', target = '~/.themes/anime
ariadne
catppuccin
e-ink
everblush
everforest
gruvbox
gruvbox-material
horizon
industrial
kanagawa
material-you
nightfox
noir
nord
rose-pine
rxyhn
tokyo-night
vira-palenight/gtk-4.0/colors.css' }
"gtk3_anime
ariadne
catppuccin
e-ink
everblush
everforest
gruvbox
gruvbox-material
horizon
industrial
kanagawa
material-you
nightfox
noir
nord
rose-pine
rxyhn
tokyo-night
vira-palenight" = { template = 'gtk-colors.css', target = '~/.themes/anime
ariadne
catppuccin
e-ink
everblush
everforest
gruvbox
gruvbox-material
horizon
industrial
kanagawa
material-you
nightfox
noir
nord
rose-pine
rxyhn
tokyo-night
vira-palenight/gtk-3.0/colors.css' }
